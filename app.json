{
  "name": "OrangeCarrier Monitor",
  "description": "Real-time call/OTP monitoring and Telegram notification bot",
  "repository": "https://github.com/jsjsj222-cim/Orangecarrier-main",
  "logo": "https://img.icons8.com/color/96/000000/orange.png",
  "keywords": ["python", "monitoring", "telegram-bot", "selenium", "chrome"],
  "env": {
    "BOT_TOKEN": {
      "description": "Telegram Bot Token (from @BotFather)",
      "value": "",
      "required": true
    },
    "ADMIN_CHAT_ID": {
      "description": "Admin Telegram Chat ID (your user id/chat id)",
      "value": "",
      "required": true
    },
    "GROUP_CHAT_ID": {
      "description": "Target Group/Channel Chat ID (example: -100xxxxxxxxxx)",
      "value": "",
      "required": true
    },
    "ORANGE_EMAIL": {
      "description": "Orange Carrier Email / Username",
      "value": "",
      "required": true
    },
    "ORANGE_PASSWORD": {
      "description": "Orange Carrier Password",
      "value": "",
      "required": true
    },
    "ORANGE_COOKIES": {
      "description": "Orange cookies JSON (export from browser, paste as JSON string)",
      "value": "",
      "required": false
    },
    "CHECK_INTERVAL": {
      "description": "Check interval in seconds (recommended: 3 to 6)",
      "value": "5",
      "required": false
    },
    "MAX_ERRORS": {
      "description": "Max consecutive errors before stopping (default 10)",
      "value": "10",
      "required": false
    },
    "LOGIN_URL": {
      "description": "Orange login URL (optional)",
      "value": "https://www.orangecarrier.com/login",
      "required": false
    },
    "CALL_URL": {
      "description": "Orange live calls URL (optional)",
      "value": "https://www.orangecarrier.com/live/calls",
      "required": false
    },
    "BASE_URL": {
      "description": "Orange base URL (optional)",
      "value": "https://www.orangecarrier.com",
      "required": false
    }
  },
  "formation": {
    "worker": {
      "quantity": 1,
      "size": "eco"
    }
  },
  "buildpacks": [
    { "url": "heroku/python" },
    { "url": "https://github.com/heroku/heroku-buildpack-google-chrome" },
    { "url": "https://github.com/heroku/heroku-buildpack-chromedriver" }
  ],
  "stack": "heroku-22"
}